# Copy to .env.live-gates for local validation only.
# Do not commit .env.live-gates.

LIVE_GATES_ENVIRONMENT=validation
LIVE_GATES_AUTHORIZE_LIVE=no

HERMES_TEST_HOST_URL=__PLACEHOLDER__
HERMES_TEST_TOKEN=__PLACEHOLDER__
HERMES_TEST_ACTOR_ID=__PLACEHOLDER__

FEISHU_APP_ID=__PLACEHOLDER__
FEISHU_APP_SECRET=__PLACEHOLDER__
FEISHU_CHAT_ID=__PLACEHOLDER__
FEISHU_EVENT_VERIFICATION_TOKEN=__PLACEHOLDER__

# Hermes Mimo model provider, used to validate all three runtime model
# positions (dialogue_model/business_model/writing_model, see
# config/model_routes.yaml) since they currently share this one provider.
# HERMES_BUSINESS_MODEL_BASE_URL should point to the Xiaomi/Mimo-compatible /v1 endpoint.
HERMES_BUSINESS_MODEL_TOKEN=__PLACEHOLDER__
HERMES_BUSINESS_MODEL_BASE_URL=__PLACEHOLDER__
HERMES_BUSINESS_MODEL_NAME=xiaomi/mimo-v2.5-pro
HERMES_BUSINESS_MODEL_CLASS=mimo

ASR_TEST_MEDIA_PATH=__PLACEHOLDER__
ASR_MODELS_ROOT=__PLACEHOLDER__

SEARCH_PROVIDER_API_KEY=__PLACEHOLDER__
SEARCH_PROVIDER_NAME=__PLACEHOLDER__
SEARCH_PROVIDER_QUERY_FILE=__PLACEHOLDER__

COLLECTOR_TEST_PROFILE_DIR=__PLACEHOLDER__
COLLECTOR_TEST_SAMPLE_URL=__PLACEHOLDER__

SHADOW_PUBLICATION_SINK=shadow-only

CONTINUOUS_RUN_DURATION_MINUTES=__PLACEHOLDER__
CONTINUOUS_RUN_MAX_EXTERNAL_CALLS=__PLACEHOLDER__
