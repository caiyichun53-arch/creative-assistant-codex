# Local secrets and machine-specific runtime config
.env
.env.*
!.env.example
!.env.live-gates.example
config/settings.yaml
config/live_gates.yaml
config/accounts/*.yaml
!config/accounts/example.yaml
config/domains/*.yaml
!config/domains/example.yaml
*secret*
*secrets*
*.pem
*.key

# Runtime data, generated artifacts, caches, and logs
data/
outputs/
logs/
.playwright-cli/
vendor/
vault/
validation_evidence/*
!validation_evidence/.gitignore
!validation_evidence/README.md
browser_profile*/
browser-profiles/
profiles/
sessions/
cookies/
*.har
*.trace
*.webm
*.mp4
*.wav
*.mp3
external_responses/
raw_external/

# Databases and transient state
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local agent/tool state
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Node/npm caches that can be recreated
node_modules/
npm-cache/

# OS/editor noise
.DS_Store
Thumbs.db
