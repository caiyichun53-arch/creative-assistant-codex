.stage_runtime/
.codex/state/
artifacts/validation/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Node/npm caches that can be recreated
node_modules/
npm-cache/

