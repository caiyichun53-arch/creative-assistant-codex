    "research_plan": "same_input_comparison_pending",
    "content_deep_research": "same_input_comparison_pending",
    "content_plan_generation": "same_input_comparison_pending",
    "formal_draft_generate": "same_input_comparison_pending",
    "copy_optimization": "same_input_comparison_pending",
    "de_ai_revision": "same_input_comparison_pending",
    "final_content_review": "same_input_comparison_pending",
    "experience_candidate_propose": "same_input_comparison_pending",
    "source_to_topic": "same_input_comparison_pending"
  },
  "completion_requires": [
    "no_direct_business_model_request_remains_in_registered_business_nodes",
    "all_registered_atomic_skills_have_standalone_boundary_declarations",
    "each_replaced_node_has_an_accepted_quality_comparison_receipt",
