{
  "contract_version": "implementation_guard_v4",
  "implementation_only": true,
  "ordinary_discussion_bypasses": true,
  "full_design_read_by_hooks": false,
  "model_calls_allowed": false,
  "absolute_workspace_paths_are_normalized": true,
  "shared_paths_require_current_stage_ownership": true,
  "unregistered_project_writes_forbidden": true,
  "current_stage_may_transition_pointer_to_next_stage": true,
  "shared_stage_validator_is_owned_by_every_business_stage": true,
  "official_apply_patch_command_field_is_parsed": true,
  "windows_interpreter_is_explicit": true,
  "implementation_state_is_isolated_per_codex_session": true,
  "hook_requested_continuation_preserves_implementation_state": true,
  "pre_tool_matchers": [
    "apply_patch"
  ],
  "post_tool_matchers": [
    "apply_patch"
  ],
  "required_events": [
    "UserPromptSubmit",
    "PreToolUse",
    "PostToolUse",
    "Stop"
  ],
  "automatic_trigger_proof_required": true
}
