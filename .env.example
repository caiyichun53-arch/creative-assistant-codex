# Copy to .env and fill local values. .env is ignored and must not be committed.

# === Business model runtime ===
# config/model_routes.yaml is the single model-routing entry point. It names
# exactly three runtime model positions -- dialogue_model, business_model,
# writing_model -- and all three resolve through one active provider choice.
# Keep any number of provider blocks configured below. To switch all formal
# routes together, change only MODEL_ACTIVE_PROVIDER_REF. Do not edit each
# route separately and do not configure fallback or provider priority.
# Fallback is disabled everywhere: if these are unset or wrong, the real
# Skill bindings raise, they never fall back to a default/local/CLI model.
#
# === Active provider choice ===
MODEL_ACTIVE_PROVIDER_REF=mimo_main

# === Direct Mimo provider ===
HERMES_BUSINESS_MODEL_TOKEN=
HERMES_BUSINESS_MODEL_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
HERMES_BUSINESS_MODEL_NAME=mimo-v2.5-pro
HERMES_BUSINESS_MODEL_CLASS=mimo

# === Optional OpenAI-compatible provider ===
GPT_RELAY_API_KEY_FILE=
GPT_RELAY_BASE_URL=https://open.sub2api.top/v1
GPT_RELAY_MODEL=gpt-5.6-terra

# === GPT/Codex workbench subscription validation ===
# This route is read-only until it passes the app-server and daily-runtime
# gates. Do not reuse the business model variables above.
CODEX_CLI_PATH=
CODEX_WORKBENCH_MODEL=
CODEX_WORKBENCH_MODEL_CLASS=codex_app_server
CODEX_WORKBENCH_TIMEOUT_SECONDS=120

# === Feishu ===
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# === Douyin Collection ===
# DOUYIN_COOKIE=
