# 复制为 .env 后填真值。.env 已被 .gitignore 排除,绝不入库。

# === LLM ===
# 日常 LLM 节点默认走 Codex CLI 无头模式(codex exec),复用本机 Codex 登录态。
# 临时回退旧 Claude 调用时可设:CREATION_LLM_PROVIDER=claude
CREATION_LLM_PROVIDER=codex
# 以后若接 DeepSeek/MiMo 等外部引擎再加对应 key。

# === 飞书(远程指挥/数据视图) ===
# 必须使用创作助手专用飞书应用/机器人,不要复用 Claude Code 的机器人。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=              # 推送目标群/会话

# === 抖音采集(MediaCrawler 扫码登录,凭证缓存在 data/ 下,这里一般留空) ===
# DOUYIN_COOKIE=
